 on:
    schedule:
      - cron: '0 14 * * *'   # UTC 14:00 = 北京时间 22:00
    workflow_dispatch:

  jobs:
    push-gold-price:
      runs-on: ubuntu-latest
      steps:
        - uses: actions/checkout@v4
        - uses: actions/setup-python@v5
          with:
            python-version: '3.11'
        - name: 运行推送脚本
          env:
            PUSHPLUS_TOKEN: ${{ secrets.PUSHPLUS_TOKEN }}
          run: python gold_price_push.py
